# 이 파일은 견본이다. 실제 값은 .env.local (로컬) 과 Vercel 환경변수에 넣는다.
# .env* 는 .gitignore 에 있어 저장소에 올라가지 않는다 (이 견본만 예외).

# 명언 읽기 - Apps Script 웹앱의 CSV 주소
# GitHub 저장소 시크릿에도 같은 이름으로 넣는다 (매일 자동 CSV 동기화가 쓴다)
GOOGLE_SHEETS_URL=https://script.google.com/macros/s/…/exec?format=csv

# 명언 쓰기 - 위와 같은 배포의 주소에서 ?format=csv 만 뺀 것
APPS_SCRIPT_URL=https://script.google.com/macros/s/…/exec

# Apps Script 의 [프로젝트 설정 → 스크립트 속성] 에 넣은 SECRET_KEY 와 같은 값
APPS_SCRIPT_KEY=

# 앱에서 본문을 고칠 때 물어보는 암호 (아무나 시트를 못 고치게 하는 관문)
EDIT_PASSWORD=

# 위 셋(APPS_SCRIPT_URL·APPS_SCRIPT_KEY·EDIT_PASSWORD) 중 하나라도 비어 있으면
# 저장 기능은 꺼진다. 로컬에서 실수로 운영 시트를 고치지 않게 하기 위해서다.
